.env
.env.*
!.env.example
!.env.frontend.example

# ─── Private keys & secrets ───────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx

# ─── Editor & OS ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Local database files ─────────────────────────────────────────────────────
*.db
*.sqlite

# ─── Coverage & test reports ─────────────────────────────────────────────────
coverage/
.nyc_output/
