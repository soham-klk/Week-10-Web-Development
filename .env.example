# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Replace with your MongoDB Atlas URI or local MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dg-interns-hub?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Use a long, random string (minimum 32 characters)
JWT_SECRET=replace_this_with_a_long_random_secret_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
